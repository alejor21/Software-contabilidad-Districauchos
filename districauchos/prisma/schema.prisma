generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// SECCIONES (Cauchos, Soportes, Rines)
model Seccion {
  id        String     @id @default(cuid())
  codigo    String     @unique // CAU, SOP, RIN
  nombre    String
  productos Producto[]
  createdAt DateTime   @default(now())
}

// PRODUCTOS CON SKU
model Producto {
  id              String   @id @default(cuid())
  sku             String   @unique
  nombre          String
  seccionId       String
  seccion         Seccion  @relation(fields: [seccionId], references: [id])
  marca           String
  medida          String?  // 195/65R15 o código de soporte
  compatibilidad  String?  // Vehículos compatibles
  costoPromedio   Decimal  @default(0) @db.Decimal(10, 2)
  precioBase      Decimal  @db.Decimal(10, 2)
  iva             Decimal  @default(19) @db.Decimal(5, 2)
  minStock        Int      @default(5)
  activo          Boolean  @default(true)
  
  stock           Stock[]
  movimientos     Movimiento[]
  ventaDetalles   VentaDetalle[]
  compraDetalles  CompraDetalle[]
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// BODEGAS
model Bodega {
  id          String       @id @default(cuid())
  nombre      String       @unique
  stock       Stock[]
  movimientos Movimiento[]
  createdAt   DateTime     @default(now())
}

// STOCK POR BODEGA
model Stock {
  productoId String
  producto   Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  bodegaId   String
  bodega     Bodega   @relation(fields: [bodegaId], references: [id], onDelete: Cascade)
  cantidad   Int      @default(0)
  
  @@id([productoId, bodegaId])
}

// MOVIMIENTOS DE INVENTARIO
model Movimiento {
  id          String   @id @default(cuid())
  tipo        String   // ENTRADA, SALIDA, AJUSTE, TRASLADO
  productoId  String
  producto    Producto @relation(fields: [productoId], references: [id])
  bodegaId    String
  bodega      Bodega   @relation(fields: [bodegaId], references: [id])
  cantidad    Int
  costoUnit   Decimal  @db.Decimal(10, 2)
  refDoc      String?  // ID de venta/compra
  observacion String?
  usuarioId   String   @default("sistema")
  fecha       DateTime @default(now())
}

// CLIENTES
model Cliente {
  id          String   @id @default(cuid())
  nit         String   @unique
  nombre      String
  telefono    String?
  email       String?
  direccion   String?
  tipoPrecio  String   @default("DETAL") // DETAL, TALLER, FLOTA
  ventas      Venta[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// VENTAS
model Venta {
  id          String         @id @default(cuid())
  consecutivo String         @unique
  clienteId   String
  cliente     Cliente        @relation(fields: [clienteId], references: [id])
  fecha       DateTime       @default(now())
  subtotal    Decimal        @db.Decimal(10, 2)
  iva         Decimal        @db.Decimal(10, 2)
  descuento   Decimal        @default(0) @db.Decimal(10, 2)
  total       Decimal        @db.Decimal(10, 2)
  estado      String         @default("COMPLETADA") // COMPLETADA, ANULADA
  metodoPago  String         @default("EFECTIVO") // EFECTIVO, TARJETA, CREDITO
  
  detalles    VentaDetalle[]
  asientoId   String?
  asiento     Asiento?       @relation(fields: [asientoId], references: [id])
  
  createdAt   DateTime       @default(now())
}

// DETALLE DE VENTAS
model VentaDetalle {
  id         String   @id @default(cuid())
  ventaId    String
  venta      Venta    @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  productoId String
  producto   Producto @relation(fields: [productoId], references: [id])
  cantidad   Int
  precioUnit Decimal  @db.Decimal(10, 2)
  ivaUnit    Decimal  @db.Decimal(10, 2)
  costoUnit  Decimal  @db.Decimal(10, 2) // Para costo de ventas
  subtotal   Decimal  @db.Decimal(10, 2)
}

// PROVEEDORES
model Proveedor {
  id       String   @id @default(cuid())
  nit      String   @unique
  nombre   String
  contacto String?
  telefono String?
  email    String?
  compras  Compra[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// COMPRAS
model Compra {
  id           String          @id @default(cuid())
  consecutivo  String          @unique
  proveedorId  String
  proveedor    Proveedor       @relation(fields: [proveedorId], references: [id])
  fecha        DateTime        @default(now())
  subtotal     Decimal         @db.Decimal(10, 2)
  iva          Decimal         @db.Decimal(10, 2)
  total        Decimal         @db.Decimal(10, 2)
  estado       String          @default("COMPLETADA")
  
  detalles     CompraDetalle[]
  asientoId    String?
  asiento      Asiento?        @relation(fields: [asientoId], references: [id])
  
  createdAt    DateTime        @default(now())
}

// DETALLE DE COMPRAS
model CompraDetalle {
  id         String   @id @default(cuid())
  compraId   String
  compra     Compra   @relation(fields: [compraId], references: [id], onDelete: Cascade)
  productoId String
  producto   Producto @relation(fields: [productoId], references: [id])
  cantidad   Int
  costoUnit  Decimal  @db.Decimal(10, 2)
  ivaUnit    Decimal  @db.Decimal(10, 2)
  subtotal   Decimal  @db.Decimal(10, 2)
}

// ASIENTOS CONTABLES
model Asiento {
  id          String          @id @default(cuid())
  fecha       DateTime        @default(now())
  descripcion String
  tipo        String          // VENTA, COMPRA, AJUSTE
  
  detalles    AsientoDetalle[]
  ventas      Venta[]
  compras     Compra[]
  
  createdAt   DateTime        @default(now())
}

// DETALLE DE ASIENTOS
model AsientoDetalle {
  id        String  @id @default(cuid())
  asientoId String
  asiento   Asiento @relation(fields: [asientoId], references: [id], onDelete: Cascade)
  cuenta    String  // Código PUC: 1105, 4135, etc.
  debe      Decimal @default(0) @db.Decimal(12, 2)
  haber     Decimal @default(0) @db.Decimal(12, 2)
  refDoc    String? // ID del documento origen
}

// PLAN DE CUENTAS (Simplificado)
model PlanCuentas {
  id          String   @id @default(cuid())
  codigo      String   @unique // 1105, 1435, etc.
  nombre      String
  tipo        String   // ACTIVO, PASIVO, PATRIMONIO, INGRESO, GASTO
  naturaleza  String   // DEBITO, CREDITO
  nivel       Int      // 1, 2, 3, 4
  padre       String?  // Código de la cuenta padre
  activa      Boolean  @default(true)
  createdAt   DateTime @default(now())
}
